# TradeLens Backend — Environment Variables
# Copy this file to .env and fill in your values

APP_NAME=TradeLens API
APP_ENV=development
APP_DEBUG=false

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://postgres:yourpassword@localhost:5432/trading_dashboard

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# MetaTrader 5 credentials (optional — only needed for auto-sync)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS_STR=http://localhost:5173,http://localhost:3000
